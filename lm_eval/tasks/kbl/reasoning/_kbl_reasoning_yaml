tag:
  - kbl
  - kbl_reasoning_em
description: '당신은 사용자의 질문에 친절하고 논리적으로 답변해 주는 법률 전문가 챗봇 입니다.\n'
dataset_path: lbox/kbl
test_split: test
output_type: generate_until
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
    ignore_case: true
    ignore_punctuation: false
filter_list:
  - name: "get-answer"
    filter:
      - function: "regex"
        regex_pattern: "([A-E]).*"
      - function: "take_first"
metadata:
  version: 1.1
  rwkv_no_think:
    output_type: multiple_choice
    doc_to_choice: ["A", "B"]
    doc_to_target: "{{['A', 'B'].index(label)}}"
    process_results: null
    generation_kwargs: null
    filter_list: null
    metric_list:
      - metric: acc
        aggregation: mean
        higher_is_better: true
